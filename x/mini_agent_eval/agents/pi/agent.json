{
  "name": "pi",
  "kind": "container",
  "dockerfile": "Dockerfile",
  "command": [
    "pi",
    "--mode",
    "json",
    "--no-session"
  ],
  "stdin": "prompt",
  "env": [
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "GEMINI_API_KEY",
    "OPENROUTER_API_KEY"
  ],
  "user": "agent",
  "version_command": [
    "pi",
    "--version"
  ]
}
