{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "noResolve": true,
    "strict": true,

    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },

  "include": [
    "resources/**/*.mjs",
    "tests/js/**/*.mjs"
  ],

  "exclude": [
    "resources/vendor/**"
  ]
}
